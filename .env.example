# ============================================================
# OpenCVMaker Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit real secrets to Git.
# ============================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=

# Authentication
AUTH_SECRET=

# Storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Payments
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional AI Provider
AI_PROVIDER=
AI_API_KEY=

# Redis / Rate Limiting
REDIS_URL=
